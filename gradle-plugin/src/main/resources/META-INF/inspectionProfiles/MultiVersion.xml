  <!-- 
    IntelliJ IDEA Inspection Profile for Multi-Version Code
    This profile suppresses warnings that are expected in preprocessed code.
    
    Usage:
    1. Copy this file to your IntelliJ project: .idea/inspectionProfiles/MultiVersion.xml
    2. Enable the profile in Settings > Editor > Inspections > Profile
    3. Optionally apply to specific files/folders only
  -->
  
  <option name="myName" value="MultiVersion Code" />
  
  <!-- Suppress unreachable code warnings in preprocessor blocks -->
  <inspection_tool class="com.intellij.codeInspection.unreachableCode.UnreachableCodeInspection" 
                   level="IGNORE" 
                   enabled="false">
    <option name="IGNORE_ASSERTIONS" value="true" />
    <option name="IGNORE_THROW_STATEMENTS" value="true" />
  </inspection_tool>
  
